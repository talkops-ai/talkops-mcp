  "name": "talkops-helm-plugin",
  "version": "0.5.0",
  "description": "Production Helm chart deployment, upgrade, rollback, troubleshooting, and security review skills paired with the TalkOps Helm MCP execution server.",
  "author": {
    "name": "TalkOps",
    "email": "contact@talkops.ai"
  },
  "license": "Apache-2.0",
  "homepage": "https://talkops.ai",
  "repository": "https://github.com/talkops-ai/talkops-mcp",
  "extensions": {
