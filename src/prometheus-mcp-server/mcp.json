{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "prometheus": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "talkops-prometheus-mcp-server==0.2.1",
        "prometheus-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "MCP_ALLOW_WRITE": "false",
        "PROMETHEUS_AUDIT_LOG_PATH": "${PLUGIN_DATA}/prometheus-audit.jsonl"
      }
    }
  }
}
