  "author": {
    "name": "TalkOps",
    "email": "contact@talkops.ai"
  },
  "license": "Apache-2.0",
  "homepage": "https://talkops.ai",
  "repository": "https://github.com/talkops-ai/talkops-mcp",
  "extensions": {
    "com.talkops": {
      "category": "gitops",
      "mcpServers": "./mcp.json",
      "skills": [
        "./skills/deploying-argocd-applications",
        "./skills/rolling-back-argocd-applications",
        "./skills/troubleshooting-argocd-applications",
        "./skills/onboarding-argocd-repositories-and-projects"
      ]
    }
  }
}
