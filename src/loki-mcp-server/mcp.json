{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "loki": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "talkops-loki-mcp-server==0.2.1",
        "loki-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "MCP_ALLOW_WRITE": "false"
      }
    }
  }
}
